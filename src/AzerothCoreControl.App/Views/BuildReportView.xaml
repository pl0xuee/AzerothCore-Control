<UserControl x:Class="AzerothCoreControl.App.Views.BuildReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:AzerothCoreControl.App.Behaviors">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- Bound to a BuildReportViewModel. Used for both a single module's row and the "Update all" batch,
         which fail in exactly the same ways and deserve the same panel. -->
    <Grid Margin="16">
        <!-- Nothing to show until a build has actually failed. -->
        <TextBlock Text="{Binding EmptyText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   TextWrapping="Wrap" VerticalAlignment="Top">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasReport}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DockPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Copy report" Command="{Binding CopyCommand}"
                        Style="{StaticResource GridButton}" />
                <TextBlock Text="{Binding Summary}"
                           Foreground="{StaticResource ErrorTextBrush}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Both lists occupy this one slot and are swapped by visibility, so they overlay in a Grid. In a
                 DockPanel the first would default to Dock=Left and render as a narrow box hugging the left edge. -->
            <Grid>
                <!-- The diagnostics themselves. -->
                <ListBox ItemsSource="{Binding Errors}"
                         Visibility="{Binding ShowErrors, Converter={StaticResource BoolToVis}}"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       TextOptions.TextFormattingMode="Display"
                                       Foreground="{StaticResource ErrorTextBrush}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Fallback when nothing matched a known compiler/CMake error format. -->
                <ListBox ItemsSource="{Binding Log}"
                         Visibility="{Binding ShowRawLog, Converter={StaticResource BoolToVis}}"
                         SelectionMode="Extended"
                         beh:AutoScrollBehavior.Enabled="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       TextOptions.TextFormattingMode="Display"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
