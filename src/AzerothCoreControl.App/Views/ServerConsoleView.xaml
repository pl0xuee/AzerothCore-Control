<UserControl x:Class="AzerothCoreControl.App.Views.ServerConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AzerothCoreControl.App.Converters"
             xmlns:beh="clr-namespace:AzerothCoreControl.App.Behaviors">
    <UserControl.Resources>
        <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel Margin="12">
        <!-- Title strip: which server this is, how many lines are buffered, and Clear. -->
        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,8">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}">
                <Run Text="{Binding LineCount, Mode=OneWay}" /><Run Text=" lines" />
            </TextBlock>
            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}"
                    Style="{StaticResource SubtleButton}" HorizontalAlignment="Right" Margin="0" />
        </DockPanel>

        <!-- Command input (worldserver only — authserver ignores stdin). -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                   Visibility="{Binding SupportsInput, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommandCommand}"
                    Style="{StaticResource AccentButton}" Margin="4,0,0,0" />
            <TextBlock DockPanel.Dock="Left" Text="&gt;" VerticalAlignment="Center" Margin="4,0,8,0"
                       FontFamily="Cascadia Mono, Consolas" FontSize="14"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBox Text="{Binding CommandInput, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SendCommandCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <ListBox ItemsSource="{Binding Output}"
                 SelectionMode="Extended"
                 beh:AutoScrollBehavior.Enabled="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,10,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                   TextWrapping="Wrap"
                                   TextOptions.TextFormattingMode="Display"
                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
