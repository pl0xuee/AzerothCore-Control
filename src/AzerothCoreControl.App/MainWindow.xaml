<Window x:Class="AzerothCoreControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AzerothCoreControl.App.Converters"
        xmlns:beh="clr-namespace:AzerothCoreControl.App.Behaviors"
        xmlns:views="clr-namespace:AzerothCoreControl.App.Views"
        Title="AzerothCore Control"
        Height="840" Width="1280"
        MinHeight="660" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/appicon.ico"
        Background="{StaticResource WindowBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- ===== Header bar ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource WindowBrush}" Padding="16,12"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/appicon.ico" Width="30" Height="30" VerticalAlignment="Center" />
                <TextBlock Text="AzerothCore Control" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Text="server supervisor &amp; updater" Style="{StaticResource Muted}"
                           VerticalAlignment="Bottom" Margin="10,0,0,3" FontSize="12" />
            </StackPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource WindowBrush}" Padding="14,6"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding AppVersion}" Margin="0,0,12,0"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource TextSecondaryBrush}" />
            </DockPanel>
        </Border>

        <TabControl Margin="0">
            <!-- ===== Dashboard ===== -->
            <TabItem Header="Dashboard">
                <StackPanel Margin="8">
                    <!-- Equal thirds rather than fixed-width cards in a WrapPanel: at 316px each they only
                         just fit the old default width, and any narrower window wrapped the third card onto
                         a line of its own, leaving a hole. These scale with the window instead. -->
                    <UniformGrid Rows="1" Columns="3">
                        <!-- World card -->
                        <Border Style="{StaticResource Card}" DataContext="{Binding World}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="13" Height="13" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="10,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" FontSize="20" FontWeight="Light" />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource Muted}">
                                    <Run Text="Uptime " /><Run Text="{Binding Uptime, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Run Text="   ·   Restarts " /><Run Text="{Binding RestartCount, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                </TextBlock>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CPU" Style="{StaticResource Muted}" FontSize="11" />
                                        <TextBlock Text="{Binding CpuText}" FontSize="16" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Memory" Style="{StaticResource Muted}" FontSize="11" />
                                        <TextBlock Text="{Binding MemoryText}" FontSize="16" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Start" Command="{Binding StartServerCommand}" Style="{StaticResource AccentButton}" />
                                    <Button Content="Stop" Command="{Binding StopServerCommand}" Style="{StaticResource SubtleButton}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource Muted}" FontSize="11"
                                           Margin="4,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Auth card -->
                        <Border Style="{StaticResource Card}" DataContext="{Binding Auth}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="13" Height="13" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="10,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" FontSize="20" FontWeight="Light" />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource Muted}">
                                    <Run Text="Uptime " /><Run Text="{Binding Uptime, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Run Text="   ·   Restarts " /><Run Text="{Binding RestartCount, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                </TextBlock>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CPU" Style="{StaticResource Muted}" FontSize="11" />
                                        <TextBlock Text="{Binding CpuText}" FontSize="16" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Memory" Style="{StaticResource Muted}" FontSize="11" />
                                        <TextBlock Text="{Binding MemoryText}" FontSize="16" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Start" Command="{Binding StartServerCommand}" Style="{StaticResource AccentButton}" />
                                    <Button Content="Stop" Command="{Binding StopServerCommand}" Style="{StaticResource SubtleButton}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource Muted}" FontSize="11"
                                           Margin="4,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- MySQL card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="MySQL" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MySqlState}" Margin="0,12,0,0" FontSize="20" FontWeight="Light" />
                                <Button Content="Start MySQL" Command="{Binding StartMySqlCommand}"
                                        Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="▶  Start all" Command="{Binding StartAllCommand}" Style="{StaticResource AccentButton}" />
                            <Button Content="■  Stop all" Command="{Binding StopAllCommand}" />
                            <Button Content="⟳  Restart world" Command="{Binding RestartWorldCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ===== Console ===== -->
            <TabItem Header="Console" DataContext="{Binding Console}">
                <!-- One pane per server: world and auth output stay in their own scrollback. -->
                <TabControl>
                    <TabItem Header="World">
                        <views:ServerConsoleView DataContext="{Binding World}" />
                    </TabItem>
                    <TabItem Header="Auth">
                        <views:ServerConsoleView DataContext="{Binding Auth}" />
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- ===== Modules ===== -->
            <TabItem Header="Modules" DataContext="{Binding Modules}">
                <DockPanel Margin="12">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <Button Content="Check modules for updates" Command="{Binding CheckModulesCommand}"
                                    Style="{StaticResource AccentButton}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Status}" Margin="4,8,0,0" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>

                    <!-- Detail panel for the selected module: what a pull would bring in, and why the last
                         build failed. -->
                    <TabControl DockPanel.Dock="Bottom" Margin="0,10,0,0" Height="230"
                                Visibility="{Binding SelectedModule, Converter={StaticResource NullToVis}}">
                        <TabItem Header="What changed">
                            <DockPanel Margin="14">
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8">
                                    <Run Text="Commits in " /><Run Text="{Binding SelectedModule.Name, Mode=OneWay}" /><Run Text=" not yet pulled" />
                                </TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedModule.IncomingCommits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ShortSha}" FontFamily="Cascadia Mono, Consolas"
                                                               Foreground="{StaticResource GoldBrush}" Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" FontSize="11">
                                                        <Run Text="{Binding Author, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Date, StringFormat=yyyy-MM-dd, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="Build report">
                            <Grid Margin="14">
                                <!-- Nothing to show until a build has actually failed. -->
                                <TextBlock Text="No failed build for this module in this session. If a build fails, the compiler errors land here."
                                           TextWrapping="Wrap" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedModule.HasBuildReport}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <DockPanel Visibility="{Binding SelectedModule.HasBuildReport, Converter={StaticResource BoolToVis}}">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Copy report"
                                                Command="{Binding SelectedModule.CopyBuildReportCommand}"
                                                Style="{StaticResource GridButton}" />
                                        <TextBlock Text="{Binding SelectedModule.BuildReportSummary}"
                                                   Foreground="{StaticResource ErrorTextBrush}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <!-- Both lists occupy this one slot and are swapped by visibility, so they
                                         overlay in a Grid. In a DockPanel the first would default to Dock=Left
                                         and render as a narrow box hugging the left edge. -->
                                    <Grid>
                                    <!-- The diagnostics themselves. -->
                                    <ListBox ItemsSource="{Binding SelectedModule.BuildErrors}"
                                             Visibility="{Binding SelectedModule.ShowBuildErrors, Converter={StaticResource BoolToVis}}"
                                             SelectionMode="Extended"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                           FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                           TextOptions.TextFormattingMode="Display"
                                                           Foreground="{StaticResource ErrorTextBrush}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Fallback when nothing matched a known compiler/CMake error format. -->
                                    <ListBox ItemsSource="{Binding SelectedModule.BuildLog}"
                                             Visibility="{Binding SelectedModule.ShowRawBuildLog, Converter={StaticResource BoolToVis}}"
                                             SelectionMode="Extended"
                                             beh:AutoScrollBehavior.Enabled="True"
                                             VirtualizingPanel.ScrollUnit="Pixel"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                           FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                           TextOptions.TextFormattingMode="Display"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    </Grid>
                                </DockPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <DataGrid ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}"
                              CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Module" Binding="{Binding Name}" Width="*" MinWidth="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Colour carries the state at a glance: red error, amber behind, muted when current. -->
                            <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Model.UpdateAvailable}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Branch" Binding="{Binding Model.Branch}" Width="Auto" MinWidth="80" />

                            <!-- Local/Remote are SHAs — monospace so they line up and compare by eye. -->
                            <DataGridTextColumn Header="Local" Binding="{Binding Model.LocalCommit}" Width="Auto" MinWidth="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Remote" Binding="{Binding Model.RemoteCommit}" Width="Auto" MinWidth="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Where it came from. For a ZIP-installed module this is the catalogue's
                                 identification by folder name, which is the only clue available. -->
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="Auto" MinWidth="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Actions" Width="Auto" MinWidth="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Pull" Command="{Binding PullCommand}"
                                                    IsEnabled="{Binding CanPull}" Style="{StaticResource GridButton}" />
                                            <Button Content="Pull + Build" Command="{Binding PullAndBuildCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                    Style="{StaticResource GridButton}" />
                                            <!-- Only for a ZIP install we could identify: turns it into a real
                                                 checkout so update checks start working. -->
                                            <Button Content="Re-clone" Command="{Binding RecloneCommand}"
                                                    IsEnabled="{Binding CanReclone}"
                                                    Style="{StaticResource GridButton}"
                                                    Visibility="{Binding IsRecloneable, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Its own column, so a long build message can't shove the buttons off-screen. -->
                            <DataGridTemplateColumn Header="Last result" Width="2*" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ActionResult}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <!-- The cell trims; the full message (often a build error) lives here. -->
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{StaticResource DarkToolTip}"
                                                         Content="{Binding ActionResult}" />
                                            </TextBlock.ToolTip>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActionFailed}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Configs (.conf editor) ===== -->
            <TabItem Header="Configs" DataContext="{Binding Configs}">
                <DockPanel Margin="12">
                    <!-- Action bar. The restart note matters: the server reads .conf only at boot, so a save
                         alone changes nothing on a running realm. -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveCommand}"
                                IsEnabled="{Binding IsDirty}" Style="{StaticResource AccentButton}" Margin="4,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Revert" Command="{Binding RevertCommand}"
                                IsEnabled="{Binding IsDirty}" Style="{StaticResource SubtleButton}" Margin="4,0,0,0" />
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="11"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>

                    <!-- File list -->
                    <Border DockPanel.Dock="Left" Width="230" Margin="0,0,10,0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <DockPanel Margin="8">
                            <DockPanel DockPanel.Dock="Top" Margin="2,0,2,8">
                                <Button DockPanel.Dock="Right" Content="Rescan" Command="{Binding RefreshCommand}"
                                        Style="{StaticResource GridButton}" Margin="0" />
                                <TextBlock Text="Config files" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.InitialShowDelay="400">
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{StaticResource DarkToolTip}" Content="{Binding Path}" />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Editor -->
                    <Grid>
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding HasSelection}"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="{StaticResource ConsoleBackgroundBrush}" />
                        <TextBlock Text="Select a config file to edit." IsHitTestVisible="False"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ===== Updates (app self-update) ===== -->
            <TabItem Header="Updates" DataContext="{Binding Updates}">
                <StackPanel Margin="12" MaxWidth="720" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Application updates" FontSize="16" FontWeight="SemiBold" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Installed version" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding CurrentVersion}" FontSize="18" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Latest release" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding LatestVersionText}" FontSize="18" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Muted}">
                                <Run Text="Source: " /><Run Text="{Binding RepositoryName, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Check for updates" Command="{Binding CheckForUpdateCommand}" Style="{StaticResource AccentButton}" />
                                <Button Content="Install &amp; restart" Command="{Binding InstallUpdateCommand}"
                                        Style="{StaticResource AccentButton}"
                                        Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <ProgressBar Height="6" Margin="4,12,0,0" Minimum="0" Maximum="100"
                                         Value="{Binding DownloadProgress}"
                                         Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource AccentBrush}"
                                         BorderThickness="0"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding StatusMessage}" Margin="4,12,0,0" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap" />

                            <StackPanel Margin="0,16,0,0">
                                <CheckBox Content="Automatically check for updates" IsChecked="{Binding AutoCheck}" Margin="0,4" />
                                <CheckBox Content="Automatically download &amp; install updates (restarts the app)" IsChecked="{Binding AutoInstall}" Margin="0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Release notes" FontWeight="SemiBold" />
                            <TextBox Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0"
                                     TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="260"
                                     VerticalScrollBarVisibility="Auto"
                                     Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ===== Schedules ===== -->
            <TabItem Header="Schedules &amp; Backups" DataContext="{Binding Schedules}">
                <!-- DockPanel, not StackPanel: a StackPanel gives the grid unbounded height, so a long job
                     list grows straight past the bottom of the tab with no scrollbar. -->
                <DockPanel Margin="12">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Back up now" Command="{Binding BackupNowCommand}" Style="{StaticResource AccentButton}" />
                            <Button Content="Restart now (with warnings)" Command="{Binding RestartNowCommand}" />
                            <TextBlock Text="{Binding BackupResult}" VerticalAlignment="Center" Margin="10,0" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>

                    <GroupBox DockPanel.Dock="Top" Header="Add a scheduled job" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding NewJobName}" Width="200" Margin="4" VerticalContentAlignment="Center" />
                            <ComboBox ItemsSource="{Binding JobKinds}" SelectedItem="{Binding NewJobKind}" Width="130" Margin="4" />
                            <TextBlock Text="at" VerticalAlignment="Center" Margin="6,0" Style="{StaticResource Muted}" />
                            <TextBox Text="{Binding NewJobHour}" Width="46" Margin="2" VerticalContentAlignment="Center" />
                            <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" />
                            <TextBox Text="{Binding NewJobMinute}" Width="46" Margin="2" VerticalContentAlignment="Center" />
                            <Button Content="Add" Command="{Binding AddJobCommand}" Style="{StaticResource SubtleButton}" Margin="8,4,4,4" />
                        </StackPanel>
                    </GroupBox>

                    <DataGrid ItemsSource="{Binding Jobs}" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeOfDay}" Width="*" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Settings ===== -->
            <TabItem Header="Settings" DataContext="{Binding Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Paths" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="Run directory (worldserver.exe / .conf)" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseRunDirCommand}" Style="{StaticResource SubtleButton}" />
                            <TextBox Text="{Binding RunDirectory}" />
                        </DockPanel>

                        <TextBlock Text="Source directory (contains modules/)" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseSourceDirCommand}" Style="{StaticResource SubtleButton}" />
                            <TextBox Text="{Binding SourceDirectory}" />
                        </DockPanel>

                        <TextBlock Text="Build directory (CMake)" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseBuildDirCommand}" Style="{StaticResource SubtleButton}" />
                            <TextBox Text="{Binding BuildDirectory}" />
                        </DockPanel>

                        <TextBlock Text="Build" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="Builds always use the RelWithDebInfo configuration — optimised, but with the debug symbols a crash dump needs."
                                   Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,8" />

                        <TextBlock Text="cmake path" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCMakeCommand}" Style="{StaticResource SubtleButton}" />
                            <TextBox Text="{Binding CMakePath}" />
                        </DockPanel>

                        <TextBlock Text="cmake-gui path (optional — found next to cmake by default)" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCMakeGuiCommand}" Style="{StaticResource SubtleButton}" />
                            <TextBox Text="{Binding CMakeGuiPath}" />
                        </DockPanel>

                        <CheckBox Content="Review CMake settings before building" IsChecked="{Binding ReviewCMakeBeforeBuild}" Margin="0,4" />
                        <TextBlock Text="Opens cmake-gui and waits for you to close it, so you can check the options (and re-generate) before the compile starts."
                                   Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,8" />

                        <TextBlock Text="MySQL &amp; Backups" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="MySQL service name (e.g. MySQL80)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding MySqlServiceName}" Margin="0,0,0,8" />

                        <TextBlock Text="Databases (auto-detected from worldserver.conf; defaults shown until detected)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DetectedDatabases}" IsReadOnly="True" Margin="0,0,0,8"
                                 Foreground="{StaticResource TextSecondaryBrush}" />

                        <TextBlock Text="mysqldump path" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseMysqlDumpCommand}" Style="{StaticResource SubtleButton}" />
                            <TextBox Text="{Binding MysqlDumpPath}" />
                        </DockPanel>

                        <TextBlock Text="Backup output directory" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseBackupDirCommand}" Style="{StaticResource SubtleButton}" />
                            <TextBox Text="{Binding BackupDirectory}" />
                        </DockPanel>

                        <TextBlock Text="GitHub &amp; Notifications" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="GitHub token (optional — lifts rate limit / private releases)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding GitHubToken}" Margin="0,0,0,8" />

                        <TextBlock Text="Discord webhook URL (optional)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DiscordWebhookUrl}" Margin="0,0,0,8" />

                        <TextBlock Text="Behaviour" Style="{StaticResource SectionHeader}" />
                        <CheckBox Content="Auto-restart servers on crash" IsChecked="{Binding AutoRestart}" Margin="0,4" />
                        <CheckBox Content="Auto-start servers when app launches" IsChecked="{Binding AutoStartServers}" Margin="0,4" />
                        <CheckBox Content="Launch app on Windows boot" IsChecked="{Binding LaunchOnBoot}" Margin="0,4" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Auto-detect paths" Command="{Binding AutoDetectCommand}" />
                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" />
                            <TextBlock Text="{Binding SaveResult}" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
