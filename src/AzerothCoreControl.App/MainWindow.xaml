<Window x:Class="AzerothCoreControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AzerothCoreControl.App.Converters"
        xmlns:vm="clr-namespace:AzerothCoreControl.App.ViewModels"
        Title="AzerothCore Control" Height="720" Width="1040"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFF7F7F9" />
            <Setter Property="BorderBrush" Value="#FFDDDDE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="8" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Busy/status bar -->
        <Border DockPanel.Dock="Bottom" Background="#FFEFEFF3" Padding="8,4">
            <TextBlock Text="{Binding BusyMessage}" Foreground="#FF444444" />
        </Border>

        <TabControl Margin="6">
            <!-- ===== Dashboard ===== -->
            <TabItem Header="Dashboard">
                <StackPanel>
                    <WrapPanel>
                        <!-- World card -->
                        <Border Style="{StaticResource Card}" Width="300" DataContext="{Binding World}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Margin="8,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" FontSize="14" />
                                <TextBlock Margin="0,4,0,0">
                                    <Run Text="Uptime: " /><Run Text="{Binding Uptime}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Restarts: " /><Run Text="{Binding RestartCount}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Auth card -->
                        <Border Style="{StaticResource Card}" Width="300" DataContext="{Binding Auth}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Margin="8,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" FontSize="14" />
                                <TextBlock Margin="0,4,0,0">
                                    <Run Text="Uptime: " /><Run Text="{Binding Uptime}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Restarts: " /><Run Text="{Binding RestartCount}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- MySQL card -->
                        <Border Style="{StaticResource Card}" Width="300">
                            <StackPanel>
                                <TextBlock Text="MySQL" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="{Binding MySqlState}" Margin="0,8,0,0" FontSize="14" />
                                <Button Content="Start MySQL" Command="{Binding StartMySqlCommand}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="12,8">
                        <Button Content="▶ Start all" Command="{Binding StartAllCommand}" />
                        <Button Content="■ Stop all" Command="{Binding StopAllCommand}" />
                        <Button Content="⟳ Restart world" Command="{Binding RestartWorldCommand}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ===== Console ===== -->
            <TabItem Header="Console" DataContext="{Binding Console}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="4">
                        <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommandCommand}" />
                        <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}" />
                        <TextBox Text="{Binding CommandInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" VerticalContentAlignment="Center" Padding="4">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendCommandCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Output}" FontFamily="Consolas" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </TabItem>

            <!-- ===== Modules ===== -->
            <TabItem Header="Modules" DataContext="{Binding Modules}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check modules for updates" Command="{Binding CheckModulesCommand}" />
                            <Button Content="Check for app update" Command="{Binding CheckForAppUpdateCommand}" />
                            <Button Content="Download update" Command="{Binding DownloadAppUpdateCommand}"
                                    Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Margin="4,4,0,0" />
                        <TextBlock Text="{Binding AppUpdateMessage}" Margin="4,0,0,0" Foreground="#FF2E6DA4" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Modules}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" Margin="8" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Module" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="*" />
                            <DataGridTextColumn Header="Branch" Binding="{Binding Model.Branch}" Width="*" />
                            <DataGridTextColumn Header="Local" Binding="{Binding Model.LocalCommit}" Width="Auto" />
                            <DataGridTextColumn Header="Remote" Binding="{Binding Model.RemoteCommit}" Width="Auto" />
                            <DataGridTemplateColumn Header="Actions" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Pull" Command="{Binding PullCommand}"
                                                    IsEnabled="{Binding CanPull}" Padding="6,2" />
                                            <Button Content="Pull + Build" Command="{Binding PullAndBuildCommand}"
                                                    Padding="6,2" />
                                            <TextBlock Text="{Binding ActionResult}" VerticalAlignment="Center" Margin="6,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Schedules ===== -->
            <TabItem Header="Schedules &amp; Backups" DataContext="{Binding Schedules}">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Back up now" Command="{Binding BackupNowCommand}" />
                        <Button Content="Restart now (with warnings)" Command="{Binding RestartNowCommand}" />
                        <TextBlock Text="{Binding BackupResult}" VerticalAlignment="Center" Margin="8,0" />
                    </StackPanel>

                    <GroupBox Header="Add a scheduled job" Margin="0,12">
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBox Text="{Binding NewJobName}" Width="180" Margin="4" />
                            <ComboBox ItemsSource="{Binding JobKinds}" SelectedItem="{Binding NewJobKind}" Width="100" Margin="4" />
                            <TextBlock Text="at" VerticalAlignment="Center" Margin="4" />
                            <TextBox Text="{Binding NewJobHour}" Width="40" Margin="2" />
                            <TextBlock Text=":" VerticalAlignment="Center" />
                            <TextBox Text="{Binding NewJobMinute}" Width="40" Margin="2" />
                            <Button Content="Add" Command="{Binding AddJobCommand}" />
                        </StackPanel>
                    </GroupBox>

                    <DataGrid ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeOfDay}" Width="*" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <!-- ===== Settings ===== -->
            <TabItem Header="Settings" DataContext="{Binding Settings}">
                <ScrollViewer>
                    <StackPanel Margin="12" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Paths" FontWeight="Bold" FontSize="14" Margin="0,4" />
                        <TextBlock Text="Run directory (worldserver.exe / .conf)" />
                        <TextBox Text="{Binding RunDirectory}" Margin="0,2,0,8" />
                        <TextBlock Text="Source directory (contains modules/)" />
                        <TextBox Text="{Binding SourceDirectory}" Margin="0,2,0,8" />
                        <TextBlock Text="Build directory (CMake)" />
                        <TextBox Text="{Binding BuildDirectory}" Margin="0,2,0,8" />

                        <TextBlock Text="MySQL &amp; Backups" FontWeight="Bold" FontSize="14" Margin="0,8,0,4" />
                        <TextBlock Text="MySQL service name (e.g. MySQL80)" />
                        <TextBox Text="{Binding MySqlServiceName}" Margin="0,2,0,8" />
                        <TextBlock Text="mysqldump path" />
                        <TextBox Text="{Binding MysqlDumpPath}" Margin="0,2,0,8" />
                        <TextBlock Text="Backup output directory" />
                        <TextBox Text="{Binding BackupDirectory}" Margin="0,2,0,8" />

                        <TextBlock Text="GitHub &amp; Notifications" FontWeight="Bold" FontSize="14" Margin="0,8,0,4" />
                        <TextBlock Text="GitHub token (optional, lifts rate limit / private releases)" />
                        <TextBox Text="{Binding GitHubToken}" Margin="0,2,0,8" />
                        <TextBlock Text="Discord webhook URL (optional)" />
                        <TextBox Text="{Binding DiscordWebhookUrl}" Margin="0,2,0,8" />

                        <CheckBox Content="Auto-restart servers on crash" IsChecked="{Binding AutoRestart}" Margin="0,8,0,2" />
                        <CheckBox Content="Auto-start servers when app launches" IsChecked="{Binding AutoStartServers}" Margin="0,2" />
                        <CheckBox Content="Launch app on Windows boot" IsChecked="{Binding LaunchOnBoot}" Margin="0,2" />

                        <StackPanel Orientation="Horizontal" Margin="0,12">
                            <Button Content="Auto-detect paths" Command="{Binding AutoDetectCommand}" />
                            <Button Content="Save" Command="{Binding SaveCommand}" />
                            <TextBlock Text="{Binding SaveResult}" VerticalAlignment="Center" Margin="8,0" Foreground="Green" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
