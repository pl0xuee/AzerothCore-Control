<Window x:Class="AzerothCoreControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AzerothCoreControl.App.Converters"
        xmlns:views="clr-namespace:AzerothCoreControl.App.Views"
        Title="AzerothCore Control"
        Height="840" Width="1280"
        MinHeight="660" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/appicon.ico"
        Background="{StaticResource WindowBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- ===== Header bar ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource WindowBrush}" Padding="16,10"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Live status, pinned to the header: whether the realm is up is the question this app
                     exists to answer, and it was only visible on the Dashboard tab. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" DataContext="{Binding World}">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                        <TextBlock Text="World" Margin="7,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DataContext="{Binding Auth}">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                        <TextBlock Text="Auth" Margin="7,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/appicon.ico" Width="28" Height="28" VerticalAlignment="Center" />
                    <TextBlock Text="AzerothCore Control" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource WindowBrush}" Padding="14,6"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding AppVersion}" Margin="0,0,12,0"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource TextSecondaryBrush}" />
            </DockPanel>
        </Border>

        <TabControl Margin="0">
            <!-- ===== Dashboard ===== -->
            <TabItem Header="Dashboard">
                <StackPanel Margin="{StaticResource PagePadding}">
                    <!-- Equal thirds rather than fixed-width cards in a WrapPanel: at 316px each they only
                         just fit the old default width, and any narrower window wrapped the third card onto
                         a line of its own, leaving a hole. These scale with the window instead.

                         A Grid with explicit 12px spacer columns, NOT a UniformGrid: UniformGrid hands every
                         child the same width and the child's margin is consumed inside that rect, so putting
                         the gap on the two left tiles made them 12px narrower than the third — and putting it
                         on all three leaves a dead strip against the page padding. The gap has to be a column. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- One card control, bound per server: this was ~35 lines of identical markup
                             duplicated, so every change had to be made twice and could drift. -->
                        <views:ServerCardView Grid.Column="0" DataContext="{Binding World}" />
                        <views:ServerCardView Grid.Column="2" DataContext="{Binding Auth}" />

                        <!-- MySQL card -->
                        <Border Grid.Column="4" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="MySQL" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MySqlState}" Margin="0,12,0,0" FontSize="20" FontWeight="Light" />
                                <Button Content="Start MySQL" Command="{Binding StartMySqlCommand}"
                                        Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="▶  Start all" Command="{Binding StartAllCommand}" Style="{StaticResource AccentButton}" />
                            <Button Content="■  Stop all" Command="{Binding StopAllCommand}" />
                            <Button Content="⟳  Restart world" Command="{Binding RestartWorldCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ===== Console ===== -->
            <TabItem Header="Console" DataContext="{Binding Console}">
                <!-- One pane per server: world and auth output stay in their own scrollback. -->
                <TabControl>
                    <TabItem Header="World">
                        <views:ServerConsoleView DataContext="{Binding World}" />
                    </TabItem>
                    <TabItem Header="Auth">
                        <views:ServerConsoleView DataContext="{Binding Auth}" />
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- ===== Modules ===== -->
            <TabItem Header="Modules" DataContext="{Binding Modules}">
                <DockPanel Margin="{StaticResource PagePadding}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStacked}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Check modules for updates" Command="{Binding CheckModulesCommand}"
                                        Style="{StaticResource AccentButton}" />
                                <!-- The batch equivalent of a row's "Pull + Build", except it pulls everything
                                     and compiles once — see UpdateAllAndBuildAsync for why that matters. -->
                                <Button Content="Update all + build" Command="{Binding UpdateAllAndBuildCommand}"
                                        Style="{StaticResource AccentButton}" Margin="8,0,0,0" />
                            </StackPanel>
                            <!-- Opt-in and destructive, so it sits next to the button that acts on it and says
                                 what it costs. Not persisted: a setting that quietly stays on would discard
                                 someone's local edits weeks after they forgot ticking it. -->
                            <CheckBox Content="Replace modules that won't pull with the latest (keeps a backup)"
                                      IsChecked="{Binding ReplaceUnpullable}" Margin="4,8,0,0"
                                      ToolTip="For a module stuck on old code by local edits or a diverged history. Its folder is moved to module-backups/ and re-cloned from its remote, so local edits and commits no longer apply. Never triggered by a network or authentication failure." />

                            <!-- Says what it does NOT touch: "clean" reads as "wipes everything", and the one
                                 thing users fear losing is the .conf files they hand-edited. -->
                            <CheckBox Content="Clean rebuild — recompile everything (your .conf files are untouched)"
                                      IsChecked="{Binding CleanBuild}" Margin="4,8,0,0"
                                      ToolTip="Re-runs CMake and rebuilds from scratch instead of compiling only what changed. Needed when a module gained or lost source files, since AzerothCore collects them at configure time. Only build artifacts are discarded — the run directory and your .conf files are not involved." />

                            <TextBlock Text="{Binding Status}" Margin="4,8,0,0" Style="{StaticResource Muted}" />

                            <!-- Batch progress: its own line so a long "update all" doesn't overwrite the
                                 check summary the user is still reading. -->
                            <TextBlock Text="{Binding BatchStatus}" Margin="4,4,0,0" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding BatchStatus, Converter={StaticResource NullToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BatchFailed}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Detail panel for the selected module: what a pull would bring in, and why the last
                         build failed. -->
                    <TabControl DockPanel.Dock="Bottom" Margin="0,12,0,0" Height="230">
                        <!-- Shown for a selected module, but ALSO whenever an "Update all" has left a build
                             report — that report belongs to no single row, and would be unreachable if the
                             panel only appeared on selection. Later triggers win, so the batch one overrides. -->
                        <TabControl.Style>
                            <Style TargetType="TabControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedModule}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BatchReport.HasReport}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.Style>

                        <TabItem Header="What changed">
                            <DockPanel Margin="16">
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8">
                                    <Run Text="Commits in " /><Run Text="{Binding SelectedModule.Name, Mode=OneWay}" /><Run Text=" not yet pulled" />
                                </TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedModule.IncomingCommits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ShortSha}" FontFamily="Cascadia Mono, Consolas"
                                                               Foreground="{StaticResource GoldBrush}" Margin="0,0,12,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" FontSize="11">
                                                        <Run Text="{Binding Author, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Date, StringFormat=yyyy-MM-dd, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="Build report">
                            <views:BuildReportView DataContext="{Binding SelectedModule.Report}"
                                                   EmptyText="No failed build for this module in this session. If a build fails, the compiler errors land here." />
                        </TabItem>

                        <!-- A failed "Update all" brings its errors to the front rather than hiding them behind
                             whichever tab was last open.

                             This is a TRIGGER, not IsSelected="{Binding ...}". A OneWay binding also pushes
                             FALSE when the report is cleared at the start of the next run — deselecting the
                             selected tab without selecting another drives SelectedIndex to -1 and blanks the
                             panel for the whole batch. A trigger reverts to the unset value instead, leaving
                             the TabControl to pick. -->
                        <TabItem Header="Update all">
                            <TabItem.Style>
                                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BatchReport.HasReport}" Value="True">
                                            <Setter Property="IsSelected" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TabItem.Style>
                            <views:BuildReportView DataContext="{Binding BatchReport}"
                                                   EmptyText="No failed &#x201C;Update all&#x201D; build in this session. One build covers every module, so its errors land here rather than on a single row." />
                        </TabItem>
                    </TabControl>

                    <!-- Horizontal scrolling stays enabled: if the columns ever outgrow the window, the
                         buttons must remain reachable rather than being cut off at the edge. -->
                    <DataGrid ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}"
                              CanUserAddRows="False" IsReadOnly="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Module" Binding="{Binding Name}" Width="*" MinWidth="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Colour carries the state at a glance: red error, amber behind, muted when current. -->
                            <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Model.UpdateAvailable}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Branch + both SHAs in one column. As three columns they cost ~220px plus their
                                 cell padding, which is what pushed the Actions buttons off the grid. -->
                            <DataGridTextColumn Header="Revision" Binding="{Binding RevisionText}" Width="Auto" MinWidth="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Where it came from. For a ZIP-installed module this is the catalogue's
                                 identification by folder name, which is the only clue available. -->
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="Auto" MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Style.Triggers>
                                            <!-- The column says where updates are actually checked from. When a
                                                 pin disagrees with that, saying so quietly here beats letting
                                                 the user believe their fork is being followed when it isn't. -->
                                            <DataTrigger Binding="{Binding HasRemoteMismatch}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                                <Setter Property="ToolTip" Value="{Binding MismatchText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- No MinWidth: Auto already sizes to the buttons, and a floor can only fight it. -->
                            <DataGridTemplateColumn Header="Actions" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Pull" Command="{Binding PullCommand}"
                                                    IsEnabled="{Binding CanPull}" Style="{StaticResource GridButton}" />
                                            <Button Content="Pull + Build" Command="{Binding PullAndBuildCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                    Style="{StaticResource GridButton}" />
                                            <!-- Only when a pin disagrees with the actual origin: repoints the
                                                 checkout at the repo the user says this module really is. -->
                                            <Button Content="{Binding SwitchButtonText}" Command="{Binding SwitchToPinnedRepoCommand}"
                                                    IsEnabled="{Binding CanSwitchRemote}"
                                                    ToolTip="{Binding MismatchText}"
                                                    Style="{StaticResource GridButton}"
                                                    Visibility="{Binding HasRemoteMismatch, Converter={StaticResource BoolToVis}}" />
                                            <!-- Only for a ZIP install we could identify: turns it into a real
                                                 checkout so update checks start working. -->
                                            <Button Content="Re-clone" Command="{Binding RecloneCommand}"
                                                    IsEnabled="{Binding CanReclone}"
                                                    Style="{StaticResource GridButton}"
                                                    Visibility="{Binding IsRecloneable, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Its own column, so a long build message can't shove the buttons off-screen. -->
                            <DataGridTemplateColumn Header="Last result" Width="*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ActionResult}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <!-- The cell trims; the full message (often a build error) lives here. -->
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{StaticResource DarkToolTip}"
                                                         Content="{Binding ActionResult}" />
                                            </TextBlock.ToolTip>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActionFailed}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Configs (.conf editor) ===== -->
            <TabItem Header="Configs" DataContext="{Binding Configs}">
                <DockPanel Margin="{StaticResource PagePadding}">
                    <!-- Action bar. The restart note matters: the server reads .conf only at boot, so a save
                         alone changes nothing on a running realm. -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveCommand}"
                                IsEnabled="{Binding IsDirty}" Style="{StaticResource AccentButton}" Margin="4,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Revert" Command="{Binding RevertCommand}"
                                IsEnabled="{Binding IsDirty}" Style="{StaticResource SubtleButton}" Margin="4,0,0,0" />
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="11"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>

                    <!-- File list -->
                    <Border DockPanel.Dock="Left" Width="230" Margin="0,0,12,0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <DockPanel Margin="8">
                            <DockPanel DockPanel.Dock="Top" Margin="2,0,2,8">
                                <Button DockPanel.Dock="Right" Content="Rescan" Command="{Binding RefreshCommand}"
                                        Style="{StaticResource GridButton}" Margin="0" />
                                <TextBlock Text="Config files" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.InitialShowDelay="400">
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{StaticResource DarkToolTip}" Content="{Binding Path}" />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Editor -->
                    <Grid>
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding HasSelection}"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="{StaticResource ConsoleBackgroundBrush}" />
                        <TextBlock Text="Select a config file to edit." IsHitTestVisible="False"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ===== Updates (app self-update) ===== -->
            <TabItem Header="Updates" DataContext="{Binding Updates}">
                <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardStacked}">
                        <StackPanel>
                            <TextBlock Text="Application updates" FontSize="16" FontWeight="SemiBold" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Installed version" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding CurrentVersion}" FontSize="18" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Latest release" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding LatestVersionText}" FontSize="18" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource Muted}">
                                <Run Text="Source: " /><Run Text="{Binding RepositoryName, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Check for updates" Command="{Binding CheckForUpdateCommand}" Style="{StaticResource AccentButton}" />
                                <Button Content="Install &amp; restart" Command="{Binding InstallUpdateCommand}"
                                        Style="{StaticResource AccentButton}"
                                        Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <ProgressBar Height="6" Margin="0,12,0,0" Minimum="0" Maximum="100"
                                         Value="{Binding DownloadProgress}"
                                         Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource AccentBrush}"
                                         BorderThickness="0"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap" />

                            <StackPanel Margin="0,12,0,0">
                                <CheckBox Content="Automatically check for updates" IsChecked="{Binding AutoCheck}" Margin="0,0,0,8" />
                                <CheckBox Content="Automatically download &amp; install updates (restarts the app)" IsChecked="{Binding AutoInstall}" Margin="0,0,0,8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Release notes" FontWeight="SemiBold" />
                            <TextBox Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0"
                                     TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="260"
                                     VerticalScrollBarVisibility="Auto"
                                     Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ===== Schedules ===== -->
            <TabItem Header="Schedules &amp; Backups" DataContext="{Binding Schedules}">
                <!-- DockPanel, not StackPanel: a StackPanel gives the grid unbounded height, so a long job
                     list grows straight past the bottom of the tab with no scrollbar. -->
                <DockPanel Margin="{StaticResource PagePadding}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStacked}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Back up now" Command="{Binding BackupNowCommand}" Style="{StaticResource AccentButton}" />
                            <Button Content="Restart now (with warnings)" Command="{Binding RestartNowCommand}" />
                            <TextBlock Text="{Binding BackupResult}" VerticalAlignment="Center" Margin="10,0" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>

                    <GroupBox DockPanel.Dock="Top" Header="Add a scheduled job" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding NewJobName}" Width="200" Margin="4" VerticalContentAlignment="Center" />
                            <ComboBox ItemsSource="{Binding JobKinds}" SelectedItem="{Binding NewJobKind}" Width="130" Margin="4" />
                            <TextBlock Text="at" VerticalAlignment="Center" Margin="6,0" Style="{StaticResource Muted}" />
                            <TextBox Text="{Binding NewJobHour}" Width="46" Margin="2" VerticalContentAlignment="Center" />
                            <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" />
                            <TextBox Text="{Binding NewJobMinute}" Width="46" Margin="2" VerticalContentAlignment="Center" />
                            <Button Content="Add" Command="{Binding AddJobCommand}" Style="{StaticResource SubtleButton}" Margin="8,4,4,4" />
                        </StackPanel>
                    </GroupBox>

                    <DataGrid ItemsSource="{Binding Jobs}" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeOfDay}" Width="*" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Settings ===== -->
            <TabItem Header="Settings" DataContext="{Binding Settings}">
                <!-- The save bar is DOCKED, not the last thing in the scroll: this page is long, and having
                     to scroll to the bottom to save the field you just edited is a trap. -->
                <DockPanel Margin="{StaticResource PagePadding}">
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveCommand}"
                                    Style="{StaticResource AccentButton}" Margin="4,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="Auto-detect paths" Command="{Binding AutoDetectCommand}"
                                    Style="{StaticResource SubtleButton}" Margin="4,0,0,0" />
                            <TextBlock Text="{Binding SaveResult}" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <!-- Each section is a card: these were flat text headers over one long list, so every
                             field sat at the same visual depth and nothing grouped. -->
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                            <Border Style="{StaticResource CardStacked}">
                                <StackPanel>
                                    <TextBlock Text="Paths" Style="{StaticResource CardHeader}" />

                                    <TextBlock Text="Run directory (worldserver.exe / .conf)" Style="{StaticResource FieldLabel}" />
                                    <DockPanel Margin="{StaticResource FieldGap}">
                                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseRunDirCommand}" Style="{StaticResource SubtleButton}" />
                                        <TextBox Text="{Binding RunDirectory}" />
                                    </DockPanel>

                                    <TextBlock Text="Source directory (contains modules/)" Style="{StaticResource FieldLabel}" />
                                    <DockPanel Margin="{StaticResource FieldGap}">
                                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseSourceDirCommand}" Style="{StaticResource SubtleButton}" />
                                        <TextBox Text="{Binding SourceDirectory}" />
                                    </DockPanel>

                                    <TextBlock Text="Build directory (CMake)" Style="{StaticResource FieldLabel}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseBuildDirCommand}" Style="{StaticResource SubtleButton}" />
                                        <TextBox Text="{Binding BuildDirectory}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStacked}">
                                <StackPanel>
                                    <TextBlock Text="Build" Style="{StaticResource CardHeader}" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Builds always use the RelWithDebInfo configuration — optimised, but with the debug symbols a crash dump needs." />

                                    <TextBlock Text="cmake path" Style="{StaticResource FieldLabel}" />
                                    <DockPanel Margin="{StaticResource FieldGap}">
                                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCMakeCommand}" Style="{StaticResource SubtleButton}" />
                                        <TextBox Text="{Binding CMakePath}" />
                                    </DockPanel>

                                    <TextBlock Text="cmake-gui path (optional — found next to cmake by default)" Style="{StaticResource FieldLabel}" />
                                    <DockPanel Margin="{StaticResource FieldGap}">
                                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCMakeGuiCommand}" Style="{StaticResource SubtleButton}" />
                                        <TextBox Text="{Binding CMakeGuiPath}" />
                                    </DockPanel>

                                    <CheckBox Content="Review CMake settings before building" IsChecked="{Binding ReviewCMakeBeforeBuild}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="24,4,0,0"
                                               Text="Opens cmake-gui and waits for you to close it, so you can check the options (and re-generate) before the compile starts." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStacked}">
                                <StackPanel>
                                    <TextBlock Text="MySQL &amp; backups" Style="{StaticResource CardHeader}" />

                                    <TextBlock Text="MySQL service name (e.g. MySQL80)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding MySqlServiceName}" Margin="{StaticResource FieldGap}" />

                                    <TextBlock Text="Databases (auto-detected from worldserver.conf; defaults shown until detected)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding DetectedDatabases}" IsReadOnly="True" Margin="{StaticResource FieldGap}"
                                             Foreground="{StaticResource TextSecondaryBrush}" />

                                    <TextBlock Text="mysqldump path" Style="{StaticResource FieldLabel}" />
                                    <DockPanel Margin="{StaticResource FieldGap}">
                                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseMysqlDumpCommand}" Style="{StaticResource SubtleButton}" />
                                        <TextBox Text="{Binding MysqlDumpPath}" />
                                    </DockPanel>

                                    <TextBlock Text="Backup output directory" Style="{StaticResource FieldLabel}" />
                                    <DockPanel Margin="{StaticResource FieldGap}">
                                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseBackupDirCommand}" Style="{StaticResource SubtleButton}" />
                                        <TextBox Text="{Binding BackupDirectory}" />
                                    </DockPanel>

                                    <CheckBox Content="Include the server's config folder in backups" IsChecked="{Binding IncludeConfigsInBackup}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStacked}">
                                <StackPanel>
                                    <TextBlock Text="Module repositories" Style="{StaticResource CardHeader}" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Pin a module to the repo you actually want it to follow — normally a fork, when the version you need isn't in the repo the module was installed from. For a module installed without git, the pin is the only way to identify it: folder names are matched against the AzerothCore catalogue, which finds the popular upstream rather than your fork. For a git checkout, the Modules tab flags the disagreement and offers to repoint it." />

                                    <DataGrid ItemsSource="{Binding ModuleRepoOverrides}" SelectedItem="{Binding SelectedOverride}"
                                              CanUserAddRows="False" IsReadOnly="False" Height="140" Margin="0,0,0,8">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Module folder" Binding="{Binding Module}" Width="*" />
                                            <DataGridTextColumn Header="Repository (owner/repo or URL)" Binding="{Binding Repository}" Width="2*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Add" Command="{Binding AddModuleRepoOverrideCommand}" Style="{StaticResource GridButton}" />
                                        <Button Content="Remove" Command="{Binding RemoveModuleRepoOverrideCommand}" Style="{StaticResource GridButton}" />
                                        <TextBlock Text="e.g.  mod-challenge-modes  →  AldebaraanMKII/mod-challenge-modes"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStacked}">
                                <StackPanel>
                                    <TextBlock Text="GitHub &amp; notifications" Style="{StaticResource CardHeader}" />

                                    <TextBlock Text="GitHub token (optional — lifts rate limit / private releases)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GitHubToken}" Margin="{StaticResource FieldGap}" />

                                    <TextBlock Text="Discord webhook URL (optional)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding DiscordWebhookUrl}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Behaviour" Style="{StaticResource CardHeader}" />
                                    <CheckBox Content="Auto-restart servers on crash" IsChecked="{Binding AutoRestart}" Margin="0,0,0,8" />
                                    <CheckBox Content="Auto-start servers when app launches" IsChecked="{Binding AutoStartServers}" Margin="0,0,0,8" />
                                    <CheckBox Content="Launch app on Windows boot" IsChecked="{Binding LaunchOnBoot}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
