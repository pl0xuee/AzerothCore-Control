<Window x:Class="AzerothCoreControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AzerothCoreControl.App.Converters"
        xmlns:beh="clr-namespace:AzerothCoreControl.App.Behaviors"
        Title="AzerothCore Control" Height="740" Width="1060"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/appicon.ico"
        Background="{StaticResource WindowBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- ===== Header bar ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource WindowBrush}" Padding="16,12"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/appicon.ico" Width="30" Height="30" VerticalAlignment="Center" />
                <TextBlock Text="AzerothCore Control" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Text="server supervisor &amp; updater" Style="{StaticResource Muted}"
                           VerticalAlignment="Bottom" Margin="10,0,0,3" FontSize="12" />
            </StackPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource WindowBrush}" Padding="14,6"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>

        <TabControl Margin="0">
            <!-- ===== Dashboard ===== -->
            <TabItem Header="Dashboard">
                <StackPanel Margin="8">
                    <WrapPanel>
                        <!-- World card -->
                        <Border Style="{StaticResource Card}" Width="316" DataContext="{Binding World}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="13" Height="13" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="10,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" FontSize="20" FontWeight="Light" />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource Muted}">
                                    <Run Text="Uptime " /><Run Text="{Binding Uptime}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Run Text="   ·   Restarts " /><Run Text="{Binding RestartCount}" Foreground="{StaticResource TextPrimaryBrush}" />
                                </TextBlock>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CPU" Style="{StaticResource Muted}" FontSize="11" />
                                        <TextBlock Text="{Binding CpuText}" FontSize="16" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Memory" Style="{StaticResource Muted}" FontSize="11" />
                                        <TextBlock Text="{Binding MemoryText}" FontSize="16" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Start" Command="{Binding StartServerCommand}" Style="{StaticResource AccentButton}" />
                                    <Button Content="Stop" Command="{Binding StopServerCommand}" Style="{StaticResource SubtleButton}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource Muted}" FontSize="11"
                                           Margin="4,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Auth card -->
                        <Border Style="{StaticResource Card}" Width="316" DataContext="{Binding Auth}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="13" Height="13" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="10,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" FontSize="20" FontWeight="Light" />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource Muted}">
                                    <Run Text="Uptime " /><Run Text="{Binding Uptime}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Run Text="   ·   Restarts " /><Run Text="{Binding RestartCount}" Foreground="{StaticResource TextPrimaryBrush}" />
                                </TextBlock>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CPU" Style="{StaticResource Muted}" FontSize="11" />
                                        <TextBlock Text="{Binding CpuText}" FontSize="16" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Memory" Style="{StaticResource Muted}" FontSize="11" />
                                        <TextBlock Text="{Binding MemoryText}" FontSize="16" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Start" Command="{Binding StartServerCommand}" Style="{StaticResource AccentButton}" />
                                    <Button Content="Stop" Command="{Binding StopServerCommand}" Style="{StaticResource SubtleButton}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource Muted}" FontSize="11"
                                           Margin="4,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- MySQL card -->
                        <Border Style="{StaticResource Card}" Width="316">
                            <StackPanel>
                                <TextBlock Text="MySQL" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MySqlState}" Margin="0,12,0,0" FontSize="20" FontWeight="Light" />
                                <Button Content="Start MySQL" Command="{Binding StartMySqlCommand}"
                                        Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <Border Style="{StaticResource Card}" Margin="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="▶  Start all" Command="{Binding StartAllCommand}" Style="{StaticResource AccentButton}" />
                            <Button Content="■  Stop all" Command="{Binding StopAllCommand}" />
                            <Button Content="⟳  Restart world" Command="{Binding RestartWorldCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ===== Console ===== -->
            <TabItem Header="Console" DataContext="{Binding Console}">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommandCommand}" Style="{StaticResource AccentButton}" />
                        <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource SubtleButton}" />
                        <TextBox Text="{Binding CommandInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendCommandCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Output}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             Foreground="#FFCBD3DC"
                             beh:AutoScrollBehavior.Enabled="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" />
                </DockPanel>
            </TabItem>

            <!-- ===== Modules ===== -->
            <TabItem Header="Modules" DataContext="{Binding Modules}">
                <DockPanel Margin="12">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <Button Content="Check modules for updates" Command="{Binding CheckModulesCommand}"
                                    Style="{StaticResource AccentButton}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Status}" Margin="4,8,0,0" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Modules}" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Module" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="*" />
                            <DataGridTextColumn Header="Branch" Binding="{Binding Model.Branch}" Width="*" />
                            <DataGridTextColumn Header="Local" Binding="{Binding Model.LocalCommit}" Width="Auto" />
                            <DataGridTextColumn Header="Remote" Binding="{Binding Model.RemoteCommit}" Width="Auto" />
                            <DataGridTemplateColumn Header="Actions" Width="2.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Pull" Command="{Binding PullCommand}"
                                                    IsEnabled="{Binding CanPull}" Style="{StaticResource SubtleButton}" />
                                            <Button Content="Pull + Build" Command="{Binding PullAndBuildCommand}" Style="{StaticResource SubtleButton}" />
                                            <TextBlock Text="{Binding ActionResult}" VerticalAlignment="Center"
                                                       Margin="8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Updates (app self-update) ===== -->
            <TabItem Header="Updates" DataContext="{Binding Updates}">
                <StackPanel Margin="12" MaxWidth="720" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Application updates" FontSize="16" FontWeight="SemiBold" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Installed version" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding CurrentVersion}" FontSize="18" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Latest release" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding LatestVersionText}" FontSize="18" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Muted}">
                                <Run Text="Source: " /><Run Text="{Binding RepositoryName}" Foreground="{StaticResource TextPrimaryBrush}" />
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Check for updates" Command="{Binding CheckForUpdateCommand}" Style="{StaticResource AccentButton}" />
                                <Button Content="Download update" Command="{Binding DownloadUpdateCommand}"
                                        Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <TextBlock Text="{Binding StatusMessage}" Margin="4,12,0,0" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Release notes" FontWeight="SemiBold" />
                            <TextBox Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0"
                                     TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="260"
                                     VerticalScrollBarVisibility="Auto"
                                     Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ===== Schedules ===== -->
            <TabItem Header="Schedules &amp; Backups" DataContext="{Binding Schedules}">
                <StackPanel Margin="12">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Back up now" Command="{Binding BackupNowCommand}" Style="{StaticResource AccentButton}" />
                            <Button Content="Restart now (with warnings)" Command="{Binding RestartNowCommand}" />
                            <TextBlock Text="{Binding BackupResult}" VerticalAlignment="Center" Margin="10,0" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>

                    <GroupBox Header="Add a scheduled job">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding NewJobName}" Width="200" Margin="4" />
                            <ComboBox ItemsSource="{Binding JobKinds}" SelectedItem="{Binding NewJobKind}" Width="110" Margin="4" />
                            <TextBlock Text="at" VerticalAlignment="Center" Margin="6,0" Style="{StaticResource Muted}" />
                            <TextBox Text="{Binding NewJobHour}" Width="46" Margin="2" />
                            <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" />
                            <TextBox Text="{Binding NewJobMinute}" Width="46" Margin="2" />
                            <Button Content="Add" Command="{Binding AddJobCommand}" Style="{StaticResource SubtleButton}" />
                        </StackPanel>
                    </GroupBox>

                    <DataGrid ItemsSource="{Binding Jobs}" CanUserAddRows="False" IsReadOnly="True" Margin="0,4,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeOfDay}" Width="*" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <!-- ===== Settings ===== -->
            <TabItem Header="Settings" DataContext="{Binding Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Paths" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="Run directory (worldserver.exe / .conf)" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseRunDirCommand}" Style="{StaticResource SubtleButton}" />
                            <TextBox Text="{Binding RunDirectory}" />
                        </DockPanel>

                        <TextBlock Text="Source directory (contains modules/)" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseSourceDirCommand}" Style="{StaticResource SubtleButton}" />
                            <TextBox Text="{Binding SourceDirectory}" />
                        </DockPanel>

                        <TextBlock Text="Build directory (CMake)" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseBuildDirCommand}" Style="{StaticResource SubtleButton}" />
                            <TextBox Text="{Binding BuildDirectory}" />
                        </DockPanel>

                        <TextBlock Text="MySQL &amp; Backups" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="MySQL service name (e.g. MySQL80)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding MySqlServiceName}" Margin="0,0,0,8" />

                        <TextBlock Text="mysqldump path" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseMysqlDumpCommand}" Style="{StaticResource SubtleButton}" />
                            <TextBox Text="{Binding MysqlDumpPath}" />
                        </DockPanel>

                        <TextBlock Text="Backup output directory" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseBackupDirCommand}" Style="{StaticResource SubtleButton}" />
                            <TextBox Text="{Binding BackupDirectory}" />
                        </DockPanel>

                        <TextBlock Text="GitHub &amp; Notifications" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="GitHub token (optional — lifts rate limit / private releases)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding GitHubToken}" Margin="0,0,0,8" />

                        <TextBlock Text="Discord webhook URL (optional)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DiscordWebhookUrl}" Margin="0,0,0,8" />

                        <TextBlock Text="Behaviour" Style="{StaticResource SectionHeader}" />
                        <CheckBox Content="Auto-restart servers on crash" IsChecked="{Binding AutoRestart}" Margin="0,4" />
                        <CheckBox Content="Auto-start servers when app launches" IsChecked="{Binding AutoStartServers}" Margin="0,4" />
                        <CheckBox Content="Launch app on Windows boot" IsChecked="{Binding LaunchOnBoot}" Margin="0,4" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Auto-detect paths" Command="{Binding AutoDetectCommand}" />
                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" />
                            <TextBlock Text="{Binding SaveResult}" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
